# Settings read by the planner (csharp_server). The code reads real environment variables and
# does not load a .env file, so set these in your shell or with setx (then reopen the terminal),
# for example:  setx OPENAI_API_KEY "your-key"
# Never commit real values.

# Required. Used for planning, decomposition, target figures and the verification judge.
OPENAI_API_KEY=

# Required for the two-model target figure. If it is unset, switch off pattern review in Unity
# so that OpenAI draws the figure once. With review on and no key the task stops with a message
# (docs/known-issues.md, A-5).
GEMINI_API_KEY=

# Optional. Model used for planning in the 0% and 50% variants. Default: gpt-5
# The 100% variant ignores it and always uses gpt-5.
ROBOT_MODEL=

# Optional. Gemini model for target figures. Default: gemini-3.1-flash-lite
GEMINI_MODEL=

# Optional, 0% and 50% variants only (the 100% variant ignores it). Set to 1 to require every task
# to start from the same block layout; the first task creates outputs/experiments/initial_scene.json
# and later tasks wait until the table matches.
FIXED_BASELINE=

# Optional. Address of the Isaac Sim server. Default: http://localhost:6000/
ISAAC_SIM_URL=
